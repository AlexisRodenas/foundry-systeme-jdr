<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="notes">
  <p class="aide">{{localize "ATLAS.Aide.Notes"}}</p>
  <label class="bloc">{{localize "ATLAS.Blessures"}}
    <textarea name="system.blessures" rows="6" placeholder="{{localize 'ATLAS.Aide.BlessuresExemple'}}">{{system.blessures}}</textarea>
  </label>
  <label class="bloc">{{localize "ATLAS.Notes"}}
    <textarea name="system.notes" rows="10">{{system.notes}}</textarea>
  </label>
</section>
